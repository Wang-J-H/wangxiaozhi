# =============================================================================
# Xiaozhi - 本地部署配置模板
# 用法：
#   cp .env.example .env
#   然后按下面注释改完再启动
# =============================================================================

# ========== 【必须改】JWT 密钥 ==========
# 容器内 XIAOZHI_ENV=production，缺少这个变量时 api 启动后登录接口会直接 500，
# 报错为：ValueError: JWT_SECRET_KEY 未配置
# 生成方法：
#   openssl rand -hex 32
JWT_SECRET_KEY=
XIAOZHI_INSTANCE_ID=instance-local-xiaozhi

# ========== 【必须改】跨域放行 ==========
# 前端跑在哪个地址就写哪个，逗号分隔，必须写完整 origin（协议+域名+端口），
# 不能带路径，不能带结尾斜杠。配错了浏览器会直接报 CORS。
# 默认前端通过 nginx 反代 /api，属于同源请求，一般用不到这项；
# 只有在浏览器直连 5050 端口时才需要。
XIAOZHI_CORS_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:5173

# ========== 管理员账号 ==========
# 本项目没有"首次启动自动创建管理员"的机制。
# 数据表建好后，需要手动执行一次 scripts/seed_admin.py 创建超级管理员：
#
#   docker compose run --rm --no-deps --entrypoint python \
#     xiaozhi-api /app/scripts/seed_admin.py
#
# 默认创建 admin / admin123（超级管理员，部门「研发部」）。
# 需要自定义时，取消下面注释并修改，脚本会读取这些环境变量：
# SEED_ADMIN_UID=admin
# SEED_ADMIN_NAME=管理员
# SEED_ADMIN_PASSWORD=请改成你自己的密码
# SEED_ADMIN_DEPT=研发部

# ========== 模式 ==========
# LITE_MODE=true 会关掉知识库/图谱/评估等重模块，只留基础对话。
# 对接场景如果不需要知识库，可以设 true，省内存
LITE_MODE=false

# ========== Neo4j 图谱数据库 ==========
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=请改成你自己的密码

# ========== MinIO 对象存储 ==========
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=请改成你自己的密码

# ========== Docker Compose 网络 ==========
SANDBOX_DOCKER_NETWORK=xiaozhi-local-network

# ========== 品牌文件 ==========
XIAOZHI_BRAND_FILE_PATH=package/xiaozhi/config/static/info.local.yaml

# ========== 本地 Qwen 模型（可选） ==========
# 如果宿主机上跑了 vLLM（OpenAI 兼容接口），填它的地址。
# 没有的话保持注释，用在线大模型即可（Web 界面里配）。
# XIAOZHI_LOCAL_QWEN_URL=http://host.docker.internal:8000/v1
